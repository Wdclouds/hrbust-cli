/* HRBUST TUI 现代暗黑极客主题样式表 */

Screen {
    background: #0b0f19;
    color: #f1f5f9;
}

Header {
    background: #0f172a;
    color: #38bdf8;
    text-style: bold;
    height: 1;
    dock: top;
}

Footer {
    background: #0f172a;
    color: #94a3b8;
    height: 1;
    dock: bottom;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 1 2;
    background: #0b0f19;
}

/* 顶部状态通知条 */
.status-bar {
    height: 3;
    background: #111827;
    border: solid #1e293b;
    padding: 0 1;
    margin-bottom: 1;
    align: center middle;
}

.network-badge-ok {
    color: #10b981;
    text-style: bold;
}

.network-badge-err {
    color: #ef4444;
    text-style: bold;
}

/* 布局卡片 */
.panel-box {
    background: #111827;
    border: solid #1e293b;
    padding: 1;
    margin-bottom: 1;
}

.panel-title {
    text-style: bold;
    color: #38bdf8;
    margin-bottom: 1;
}

/* 表格样式 */
DataTable {
    background: #111827;
    border: solid #1e293b;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #1e293b;
    color: #38bdf8;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #0369a1;
    color: #ffffff;
    text-style: bold;
}

/* 按钮与交互控件 */
Button {
    background: #1e293b;
    color: #f1f5f9;
    border: none;
    height: 3;
    min-width: 14;
    margin-right: 1;
}

Button:hover {
    background: #0284c7;
    color: #ffffff;
}

Button.primary {
    background: #0284c7;
    color: #ffffff;
    text-style: bold;
}

Button.primary:hover {
    background: #0369a1;
}

Button.success {
    background: #059669;
    color: #ffffff;
    text-style: bold;
}

Button.danger {
    background: #dc2626;
    color: #ffffff;
}

Input {
    background: #1e293b;
    color: #f8fafc;
    border: solid #334155;
    padding: 0 1;
    height: 3;
}

Input:focus {
    border: solid #38bdf8;
}

Select {
    background: #1e293b;
    color: #f8fafc;
    border: solid #334155;
    height: 3;
}

/* 控制栏行 */
.toolbar-row {
    height: 3;
    margin-bottom: 1;
    align: left middle;
}

/* 水控出码展示大卡片 */
.voucher-card {
    background: #1e293b;
    border: solid #10b981;
    padding: 1 2;
    margin-top: 1;
    height: auto;
    align: center middle;
}

.voucher-code {
    text-style: bold;
    color: #facc15;
    background: #000000;
    padding: 0 2;
    margin: 1 0;
}

/* 详情预览视窗 */
.detail-preview {
    background: #0f172a;
    border: dashed #334155;
    padding: 1;
    height: 7;
    margin-top: 1;
}
