/* HRBUST TUI 现代暗黑极客命令中枢主题样式表 - 极简扁平去框线设计 */

Screen {
    background: #0b0f19;
    color: #f1f5f9;
}

Header {
    background: #0f172a;
    color: #38bdf8;
    text-style: bold;
    height: 1;
    dock: top;
}

Footer {
    background: #0f172a;
    color: #94a3b8;
    height: 1;
    dock: bottom;
}

/* 顶部状态通知条: 仅保留底部分隔单线 */
.top-status-bar {
    height: 3;
    background: #0f172a;
    border: none;
    border-bottom: solid #1e293b;
    padding: 0 1;
    align: left middle;
    dock: top;
}

.top-status-bar Static {
    width: auto;
    margin-right: 2;
}

/* 核心两列水平分割布局 */
.layout-columns {
    height: 1fr;
}

/* 左侧 3/4 主命令甲板: 无外包围框，全靠内部分区 */
#main-deck {
    width: 75%;
    height: 1fr;
    padding: 1 2 0 2;
    background: #0b0f19;
}

/* 工作空间视图容器 */
#workspace-view {
    height: 1fr;
}

/* 居中大 Logo 与引导卡片 */
#hero-view {
    width: 100%;
    height: 100%;
    align: center middle;
    content-align: center middle;
}

.ascii-logo {
    color: #38bdf8;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

.hero-subtitle {
    color: #94a3b8;
    text-align: center;
    margin-bottom: 1;
}

/* 快捷指引面板: 取消四面封闭硬框，改用左侧青色提示线与沉浸深色底 */
.quick-guide-panel {
    background: #0f172a;
    border: none;
    border-left: wide #0284c7;
    padding: 1 2;
    width: 85%;
    align: center middle;
}

.guide-title {
    color: #38bdf8;
    text-style: bold;
    text-align: left;
    margin-bottom: 1;
}

.guide-item {
    color: #cbd5e1;
    margin-bottom: 0;
}

/* 各业务视图卡片 */
.view-panel {
    width: 100%;
    height: 100%;
}

.view-header-bar {
    height: 3;
    align: left middle;
    margin-bottom: 1;
    border: none;
    border-bottom: solid #1e293b;
    padding-bottom: 0;
}

.view-header-title {
    color: #38bdf8;
    text-style: bold;
}

/* 最下方常驻命令输入条: 取消四周围框，仅保留顶部分隔单线 */
#command-container {
    height: 3;
    margin-top: 0;
    background: #0f172a;
    border: none;
    border-top: solid #1e293b;
    padding: 0 1;
    align: left middle;
}

#command-prompt-symbol {
    width: 3;
    color: #38bdf8;
    text-style: bold;
}

#command-input {
    width: 1fr;
    background: transparent;
    border: none;
    color: #f8fafc;
    padding: 0;
}

#command-input:focus {
    border: none;
}

/* 右侧 1/4 学校公告栏: 仅保留左侧一根区域垂直分割线，内部彻底去框 */
#news-sidebar {
    width: 25%;
    height: 1fr;
    background: #0b0f19;
    border: none;
    border-left: solid #1e293b;
    padding: 1 1 0 1;
}

.sidebar-header {
    height: 3;
    border: none;
    border-bottom: solid #1e293b;
    align: left middle;
    margin-bottom: 1;
}

.sidebar-title {
    color: #38bdf8;
    text-style: bold;
}

#news-scroll-container {
    height: 1fr;
}

/* 彻底取消新闻卡片的四周实线框 (不再有空心黑框)，改用极简紧凑无框信息流 */
.news-card {
    height: auto;
    background: transparent;
    border: none;
    border-bottom: dashed #1e293b;
    padding: 0 0 1 0;
    margin-bottom: 1;
}

.news-card Label {
    height: auto;
    width: 100%;
}

.news-card:hover {
    background: #0f172a;
    border: none;
    border-bottom: solid #38bdf8;
}

.news-date {
    color: #f59e0b;
    text-style: bold;
    margin-bottom: 0;
}

.news-title {
    color: #e2e8f0;
}

/* 表格与结果面板: 融入深色背景，取消外围大粗框，仅保留顶线 */
DataTable {
    background: #0b0f19;
    border: none;
    border-top: solid #1e293b;
    height: 1fr;
}

DataTable > .datatable--header {
    background: #0f172a;
    color: #38bdf8;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #0369a1;
    color: #ffffff;
    text-style: bold;
}

Button {
    background: #1e293b;
    color: #f1f5f9;
    border: none;
    height: 3;
    min-width: 10;
    margin-right: 1;
}

Button:hover {
    background: #0284c7;
    color: #ffffff;
}

Button.primary {
    background: #0284c7;
    color: #ffffff;
    text-style: bold;
}

/* 出码凭证卡片: 取消四周围框，改为左侧绿色高亮强调线 */
.voucher-card {
    background: #0f172a;
    border: none;
    border-left: wide #10b981;
    padding: 0 1;
    margin-top: 1;
    height: 3;
    align: left middle;
}

/* 凭据面板卡片: 取消硬线方框，改为左侧青色提示线 */
.panel-box {
    height: auto;
    background: #0f172a;
    border: none;
    border-left: wide #38bdf8;
    padding: 0 1;
    margin-bottom: 1;
}

.panel-box Label {
    height: auto;
    width: 100%;
}

/* ==================== 任务 B: 文章详情阅读器样式 ==================== */
#article-scroll-container {
    height: 1fr;
    background: #0b0f19;
    padding: 1 2;
}

#article-deck-title {
    color: #38bdf8;
    text-style: bold;
    margin-bottom: 1;
}

#article-deck-meta {
    color: #94a3b8;
    border-bottom: solid #1e293b;
    padding-bottom: 1;
    margin-bottom: 1;
}

#article-deck-content {
    color: #f1f5f9;
    margin-bottom: 2;
}

#article-deck-attachments {
    color: #facc15;
    background: #0f172a;
    border: none;
    border-left: wide #f59e0b;
    padding: 1 2;
    margin-top: 1;
}

/* ==================== 任务 C: 办事大厅独立认证中心视图样式 ==================== */
#auth-scroll-container {
    height: 1fr;
    background: #0b0f19;
    padding: 1 2;
}

.auth-header-desc {
    color: #94a3b8;
    margin-bottom: 1;
    border-bottom: solid #1e293b;
    padding-bottom: 1;
}

#auth-deck-split {
    height: auto;
    width: 100%;
    margin-top: 1;
}

.auth-card {
    height: auto;
    background: #0f172a;
    border: none;
    border-left: wide #38bdf8;
    padding: 1 2;
    margin-right: 1;
    margin-bottom: 1;
    width: 1fr;
}

#auth-pwd-card {
    border-left: wide #f59e0b;
}

.auth-card-title {
    color: #facc15;
    text-style: bold;
    margin-bottom: 1;
}

.auth-card-sub {
    color: #94a3b8;
    margin-bottom: 1;
}

.auth-card Input {
    margin-bottom: 1;
}

.auth-card Button {
    margin-top: 1;
    margin-bottom: 1;
}

#qr-code-display {
    color: #f8fafc;
    background: #020617;
    border: solid #1e293b;
    padding: 1 2;
    margin-bottom: 1;
    width: auto;
    height: auto;
}

#qr-status-display {
    color: #38bdf8;
    text-style: bold;
    margin-top: 1;
    margin-bottom: 1;
}

#label-cas-submit-status {
    margin-top: 1;
}
